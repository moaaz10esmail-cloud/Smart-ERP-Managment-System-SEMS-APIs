{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\ProjectModels;Database=SEMSDb;Trusted_Connection=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SEMS",
    "Audience": "SEMS",
    "Secret": "this-is-a-very-long-secret-key-of-at-least-32-chars",
    "ExpireMinutes": 60
  },
  "UseRedis": false,
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "UseRabbitMq": false,
  "RabbitMq": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/sems-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}

